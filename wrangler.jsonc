{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "player-character-manager-api",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,https://player-character-manager.canterburysocietyinfo.workers.dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "player-dashboard-db",
      "database_id": "9ac40f83-1308-422b-850e-fcc8dc341c1b",
      "migrations_dir": "worker/migrations",
    },
  ],
}
